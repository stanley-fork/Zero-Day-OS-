# /etc/xdg/cage/config — ZERO-DAY OS Wayland compositor setup
# cage: a kiosk Wayland compositor, runs the GUI launcher fullscreen
# When HDMI is connected, cage outputs to BOTH LCD and HDMI (mirror mode)
#
# Install: apt install cage
# Alternative: sway (full Wayland WM, heavier ~15MB more RAM)
#
# Boot chain:
#   systemd → zeroday-boot.service → cage (Wayland kiosk)
#   cage runs cyber_launcher (Pygame on Wayland via SDL2)
#
# If cage/Wayland fail, fallback to Xorg + i3 + st (TUI mode)
#
# Wayland is preferred because:
#   - Lower latency on framebuffer
#   - No X11 overhead (~5MB RAM savings)
#   - Direct DRM/KMS rendering on both outputs
#   - Better suited for single-app kiosk
#
# HDMI external monitor:
#   - Auto-detected via DRM hotplug (udev + compositor)
#   - All apps appear on both LCD and HDMI simultaneously
#   - 1080P@30fps max on RP3A0
#   - Set ZERODAY_DISPLAY=hdmi to force HDMI output

WAYLAND_DISPLAY=wayland-0
SDL_VIDEODRIVER=wayland
PYGAME_HIDE_SUPPORT_PROMPT=1
SDL_RENDER_DRIVER=opengles2

# HDMI hotplug: auto-detect HDMI monitor as second output
ZERODAY_HDMI=0

# Display dimensions
ZERODAY_LCD_WIDTH=320
ZERODAY_LCD_HEIGHT=170
ZERODAY_HDMI_WIDTH=1920
ZERODAY_HDMI_HEIGHT=1080
ZERODAY_HDMI_FPS=30

# When HDMI is connected, applications render to 1080P output.
# The LCD continues showing the same content at 320x170 (mirror).
# All installed programs, tools, and apps work on HDMI automatically.
WLR_OUTPUTS=ST7789V,HDMI-A-1