# /etc/sway/config — ZERO-DAY OS Sway Wayland Compositor
# Dual-output: LCD (320x170) primary + HDMI (1080P) external monitor
#
# HDMI is auto-detected via hotplug. When connected:
#   - All apps/windows appear on BOTH displays (mirror mode)
#   - HDMI runs at 1080P@30fps (RP3A0 bandwidth limit)
#   - When disconnected, reverts to LCD-only
#
# Install: apt install sway
# Enable: systemctl enable zeroday-gui.service (uses cage)
#         OR swap ExecStart to use sway instead

# ── Output configuration ──
# LCD: ST7789V 320x170 — always enabled, primary
output ST7789V {
    mode 320x170@30Hz
    pos 0 0
    bg /opt/cardputer/bg.png fill
}

# HDMI: external monitor — auto-detect, mirror LCD content
# When no monitor is connected, this output is disabled automatically
output HDMI-A-1 {
    mode 1920x1080@30Hz
    pos 0 0
    bg /opt/cardputer/bg.png fill
    disable
}

# ── HDMI hotplug: enable output when monitor connected ──
# This is handled by the compositor and udev rules.
# When HDMI is connected, zeroday-comp/waybar enables HDMI-A-1.
set $hdmi_state $(cat /sys/class/drm/card0-HDMI-A-1/status 2>/dev/null || echo disconnected)

# ── Input configuration ──
# Built-in 46-key keyboard (TCA8418) + any USB keyboard
input * {
    xkb_layout us
    tap enabled
    natural_scroll disabled
    dwt enabled
}

# ── Window management ──
# No title bars, no gaps — maximize screen space
font pango:Terminus 8
default_border none
default_floating_border none
hide_edge_borders both
focus_follows_mouse no

# ── Startup ──
exec_always cyber_launcher

# ── Keybindings (Fn = Alt/Mod1) ──
set $mod Mod1
set $term foot

bindsym $mod+Tab exec cyber_launcher
bindsym $mod+p exec panic
bindsym $mod+space exec stealth-backlight-toggle
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+o exec opencode-session
bindsym $mod+m exec st -e jellyfin-tv

bindsym $mod+n exec $term -e sudo net-quickscan
bindsym $mod+b exec $term -e sudo bt-scan
bindsym $mod+s exec $term -e revshell-listen
bindsym $mod+w exec cardputer-wifi-toggle
bindsym $mod+c exec cam-snap
bindsym $mod+i exec $term -e sudo ir-scan
bindsym $mod+a exec $term -e opencode
bindsym $mod+d exec $term -e dongle-setup status
bindsym $mod+g exec $term -e doom-play
bindsym $mod+r exec $term -e retro-play
bindsym $mod+y exec $term -e "yt search"

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4

bindsym $mod+Shift+q exec swaynag -t warning -m "Press Shift+q to exit sway" -B "Exit" "swaymsg exit"

# ── HDMI toggle keybinding ──
# Fn+Shift+M toggles HDMI output on/off
bindsym $mod+Shift+m exec swaymsg output HDMI-A-1 toggle

# No bar — screen too small on LCD
bar {
    mode invisible
}