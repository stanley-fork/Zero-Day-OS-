#!/bin/bash
set -euo pipefail
# /usr/local/bin/c6l-ctl
# M5Stack Unit C6L (ESP32-C6 + 0.96" LCD) controller for ZERO-DAY OS
#
# The C6L connects to M5MonsterC5's Grove OUT port. All C6L commands
# are routed through the MonsterC5 middle-manager firmware via serial
# multiplexing. Direct USB-C connection is also supported for flashing.
#
# Grove chain: Cardputer Zero → M5MonsterC5 (IN) → C6L (OUT)
#   M5MonsterC5 routes: GPS (Grove IN) + C6L (Grove OUT) + WiFi attacks
#
# C6L's unique value: Zigbee/Thread (802.15.4) and BLE 5 —
# capabilities no other device in ZERO-DAY OS provides.
# WiFi 6 scan/deauth included as bonus; M5MonsterC5 is the
# primary WiFi attack radio.
#
# Communication:
#   Via MonsterC5:  monsterctl c6l_cmd <command>  (preferred)
#   Direct USB-C:   /dev/ttyUSB0                  (for flashing/testing)
#
# Usage:
#   c6l-ctl probe                Probe for Unit C6L via MonsterC5
#   c6l-ctl flash <firmware>     Flash firmware to C6L (direct USB-C)
#   c6l-ctl wifi scan             WiFi 6 scan via C6L
#   c6l-ctl wifi deauth <BSSID> <CH>  Deauth via C6L WiFi 6 radio
#   c6l-ctl zigbee scan           Scan Zigbee/Thread networks
#   c6l-ctl zigbee sniffer       Start Zigbee packet capture
#   c6l-ctl zigbee attack <opts> Zigbee network attacks
#   c6l-ctl ble scan              BLE 5 scan via C6L
#   c6l-ctl ble connect <MAC>    Connect to BLE peripheral
#   c6l-ctl ble pair              Scan and pair C6L via direct BLE (no MonsterC5)
#   c6l-ctl lcd text <msg>        Display text on C6L LCD
#   c6l-ctl lcd status            Show system status on C6L LCD
#   c6l-ctl serial                Open serial console to C6L (direct USB)
#   c6l-ctl reset                  Reset C6L
#   c6l-ctl config                 Show C6L configuration and wiring

C6L_MODE="${C6L_MODE:-auto}"
C6L_I2C_BUS="${C6L_I2C_BUS:-1}"
C6L_I2C_ADDR="${C6L_I2C_ADDR:-0x3C}"
C6L_UART="${C6L_UART:-/dev/ttyUSB0}"
C6L_UART_BAUD="${C6L_UART_BAUD:-115200}"
C6L_LCD_TYPE="${C6L_LCD_TYPE:-ssd1306}"
C6L_BLE_MAC="${C6L_BLE_MAC:-}"  # Paired C6L BLE MAC address
FIRMWARE_DIR="/opt/cardputer/c6l/firmware"
WIFI_LOOT="/opt/cardputer/loot/wifi"
ZIGBEE_LOOT="/opt/cardputer/loot/zigbee"

c6l_send() {
    local cmd="$1"
    if [ "$C6L_MODE" = "ble" ]; then
        # Direct BLE connection to C6L (no MonsterC5, no USB cable)
        if [ -z "$C6L_BLE_MAC" ]; then
            echo -e "${RED}No C6L BLE MAC set. Run: c6l-ctl ble scan${NC}"
            return 1
        fi
        # Use bluetoothctl to send command over BLE
        echo -e "${CYAN}[BLE → C6L ${C6L_BLE_MAC}] ${cmd}${NC}"
        echo "$cmd" | bluetoothctl --timeout 5 <<< "connect ${C6L_BLE_MAC}" 2>/dev/null || \
            gatttool -b "${C6L_BLE_MAC}" --char-write-req -a 0xFFE1 -n "$(echo -n "$cmd" | xxd -p)" 2>/dev/null || \
            echo -e "${YELLOW}BLE command sent (may need pairing first)${NC}"
    elif [ "$C6L_MODE" = "direct" ] || ! command -v monsterctl >/dev/null 2>&1; then
        if [ ! -e "${C6L_UART}" ]; then
            echo -e "${RED}No direct serial connection at ${C6L_UART}${NC}"
            echo "  Connect C6L via USB-C or set C6L_UART"
            return 1
        fi
        echo "$cmd" > "${C6L_UART}" 2>/dev/null
    else
        monsterctl c6l_cmd "$cmd" 2>/dev/null
    fi
}

c6l_read() {
    local duration="${1:-5}"
    if [ "$C6L_MODE" = "direct" ] || ! command -v monsterctl >/dev/null 2>&1; then
        timeout "$duration" cat "${C6L_UART}" 2>/dev/null || true
    else
        echo "[response via MonsterC5 passthrough]"
    fi
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

cmd_probe() {
    echo -e "${BOLD}M5Stack Unit C6L (ESP32-C6) Probe${NC}"
    echo ""
    
    echo -e "${CYAN}Scanning I2C bus ${C6L_I2C_BUS}...${NC}"
    if [ -e "/dev/i2c-${C6L_I2C_BUS}" ]; then
        local scan=$(i2cdetect -y "${C6L_I2C_BUS}" 2>/dev/null || true)
        if echo "$scan" | grep -q "3C"; then
            echo -e "  ${GREEN}LCD (SSD1306) detected at 0x3C${NC}"
        elif echo "$scan" | grep -q "3D"; then
            echo -e "  ${GREEN}LCD (SH1107) detected at 0x3D${NC}"
        else
            echo -e "  ${YELLOW}No LCD on I2C (C6L may be in UART mode)${NC}"
        fi
    else
        echo -e "  ${YELLOW}I2C bus not available${NC}"
    fi
    
    echo ""
    echo -e "${CYAN}Scanning UART/USB...${NC}"
    local uart_found=false
    for dev in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyACM0 /dev/ttyACM1; do
        if [ -e "$dev" ]; then
            echo -e "  ${GREEN}Serial device: ${dev}${NC}"
            uart_found=true
            C6L_UART="$dev"
            local vid=$(cat "/sys/class/tty/$(basename $dev)/../../idVendor" 2>/dev/null || echo "?")
            local mfr=$(cat "/sys/class/tty/$(basename $dev)/../../manufacturer" 2>/dev/null || echo "?")
            local prod=$(cat "/sys/class/tty/$(basename $dev)/../../product" 2>/dev/null || echo "?")
            if [ "$vid" = "303a" ] || echo "$prod" | grep -qi "c6\|esp32"; then
                echo -e "  ${GREEN}ESP32-C6 detected: ${mfr} ${prod}${NC}"
            else
                echo -e "  ${YELLOW}USB serial: ${mfr} ${prod} (vid=${vid})${NC}"
            fi
        fi
    done
    [ "${uart_found}" = false ] && echo -e "  ${YELLOW}No USB serial device found${NC}"
    
    echo ""
    echo -e "${CYAN}Unit C6L Specifications:${NC}"
    echo "  Chip:           ESP32-C6 (160MHz RISC-V, 300KB SRAM, 4MB Flash)"
    echo "  WiFi:           802.11ax (WiFi 6), 802.11b/g/n 2.4GHz"
    echo "  Bluetooth:     BLE 5.0"
    echo "  802.15.4:      Zigbee 3.0 / Thread 1.3  ← unique capability"
    echo "  LCD:            0.96\" 128x64 (SSD1306)"
    echo "  Interface:      Grove HY2.0-4P (I2C + UART, via M5MonsterC5 OUT)"
    echo "  USB-C:         Programming + power + serial"
    echo ""
    echo -e "${CYAN}Grove chain: Cardputer Zero → M5MonsterC5 (IN) →${NC}"
    echo -e "${CYAN}  M5MonsterC5 has GPS Module v1.1 port + OUT port for C6L${NC}"
    echo -e "${CYAN}C6L unique value: Zigbee/Thread + BLE 5 (no other device covers this)${NC}"
    echo -e "${CYAN}WiFi 6 available as bonus; M5MonsterC5 is the primary WiFi attack radio${NC}"
    echo ""
    echo -e "${CYAN}C6L wiring — M5MonsterC5 Grove OUT port:${NC}"
    echo "  C6L Pin            M5MonsterC5 OUT"
    echo "  ──────────         ────────────────────"
    echo "  GND (Black)     →   Pin 1 (GND)"
    echo "  5V (Red)         →   Pin 2 (VCC 5V)"
    echo "  SDA (Yellow)     →   Pin 3 (SDA — I2C data)"
    echo "  SCL (White)      →   Pin 4 (SCL — I2C clock)"
    echo ""
    echo -e "${CYAN}C6L UART mode — M5MonsterC5 Grove OUT port:${NC}"
    echo "  C6L Pin            M5MonsterC5 OUT"
    echo "  ──────────         ────────────────────"
    echo "  GND (Black)     →   Pin 1 (GND)"
    echo "  5V (Red)         →   Pin 2 (VCC 5V)"
    echo "  TX (Yellow)      →   Pin 3 (RX — UART receive)"
    echo "  RX (White)       →   Pin 4 (TX — UART transmit)"
    echo ""
    echo "  Grove switches: SW1=OFF, SW2=OFF for UART mode"
    echo "  Grove switches: SW1=ON, SW2=ON for I2C mode"
}

cmd_wifi_scan() {
    echo -e "${BOLD}WiFi 6 scan via Unit C6L...${NC}"
    mkdir -p "${WIFI_LOOT}"
    
    echo -e "${YELLOW}Scanning for WiFi networks (15s)...${NC}"
    c6l_send "WIFI_SCAN" || return 1
    local outfile="${WIFI_LOOT}/c6l_wifi_scan_$(date +%Y%m%d_%H%M%S).log"
    c6l_read 15 > "${outfile}"
    echo -e "${GREEN}Scan complete: ${outfile}${NC}"
    cat "${outfile}"
}

cmd_wifi_deauth() {
    local bssid="${1:-}"
    local channel="${2:-}"
    if [ -z "$bssid" ] || [ -z "$channel" ]; then
        echo -e "${RED}Usage: c6l-ctl wifi deauth <BSSID> <CHANNEL>${NC}"
        echo ""
        echo "  BSSID    Target access point MAC address"
        echo "  CHANNEL  Target channel (1-13 for 2.4GHz)"
        echo ""
        echo -e "${YELLOW}Note: M5MonsterC5 (monsterctl) is the primary WiFi attack device.${NC}"
        echo "  Use the C6L for WiFi 6 (802.11ax) specific targets."
        return 1
    fi
    
    echo -e "${RED}${BOLD}WiFi deauth: ${bssid} on channel ${channel} via C6L${NC}"
    echo -e "${YELLOW}Sending deauth frames via C6L WiFi 6 radio${NC}"
    
    c6l_send "WIFI_DEAUTH_${bssid}_${channel}" || return 1
    echo -e "${GREEN}Deauth command sent${NC}"
    echo "  Monitoring for 10s..."
    c6l_read 10
}

