cmd_serial() {
    if [ "$C6L_MODE" != "direct" ]; then
        echo -e "${YELLOW}Note: For interactive C6L serial console, use direct USB-C connection.${NC}"
        echo -e "${YELLOW}Set C6L_MODE=direct and C6L_UART=/dev/ttyUSBx to use serial console.${NC}"
        echo -e "${YELLOW}Otherwise, use: monsterctl c6l_passthrough${NC}"
        echo ""
    fi
    
    if [ ! -e "${C6L_UART}" ]; then
        echo -e "${RED}No serial device at ${C6L_UART}${NC}"
        echo "  Connect C6L via USB-C or set C6L_UART"
        echo "  Set C6L_MODE=direct for serial console"
        return 1
    fi
    
    echo -e "${BOLD}Serial console to C6L (${C6L_UART} @ ${C6L_UART_BAUD})${NC}"
    echo -e "  ${YELLOW}Direct USB-C only. Via MonsterC5: use monsterctl c6l_passthrough${NC}"
    echo "  Press Ctrl+] to exit"
    echo ""
    
    if command -v picocom >/dev/null 2>&1; then
        picocom "${C6L_UART}" -b "${C6L_UART_BAUD}" 2>/dev/null
    elif command -v minicom >/dev/null 2>&1; then
        minicom -D "${C6L_UART}" -b "${C6L_UART_BAUD}" 2>/dev/null
    else
        stty -F "${C6L_UART}" "${C6L_UART_BAUD}" raw -echo 2>/dev/null || true
        cat "${C6L_UART}" &
        local cat_pid=$!
        while IFS= read -r line; do
            echo "$line" > "${C6L_UART}" 2>/dev/null
        done
        kill "$cat_pid" 2>/dev/null || true
    fi
}

cmd_reset() {
    echo -e "${BOLD}Resetting Unit C6L...${NC}"
    c6l_send "RESET" || {
        echo -e "${YELLOW}Cannot reach C6L via MonsterC5 — trying direct reset${NC}"
        if [ -e "${C6L_UART}" ]; then
            stty -F "${C6L_UART}" "${C6L_UART_BAUD}" 2>/dev/null || true
            echo "RESET" > "${C6L_UART}" 2>/dev/null || true
            echo -e "${GREEN}Reset command sent (direct)${NC}"
        else
            echo -e "${YELLOW}No connection — connect USB-C to reset${NC}"
        fi
        return 0
    }
    echo -e "${GREEN}Reset command sent (via MonsterC5)${NC}"
}

cmd_flash() {
    local firmware="${1:-}"
    if [ -z "$firmware" ]; then
        echo -e "${BOLD}Available C6L firmwares:${NC}"
        echo "  wifi-scanner       — WiFi 6 scanner + deauth"
        echo "  zigbee-sniffer     — Zigbee/Thread packet sniffer"
        echo "  zigbee-attacker   — Zigbee network attacker"
        echo "  ble-scanner       — BLE 5 scanner + GATT client"
        echo "  c6l-companion     — Full companion (default)"
        echo ""
        echo "Usage: c6l-ctl flash <firmware>"
        echo "Firmware dir: ${FIRMWARE_DIR}"
        return 1
    fi
    
    local fw_path="${FIRMWARE_DIR}/${firmware}.bin"
    if [ ! -f "$fw_path" ]; then
        echo -e "${RED}Firmware not found: ${fw_path}${NC}"
        ls "${FIRMWARE_DIR}/"*.bin 2>/dev/null || echo "  (none)"
        return 1
    fi
    
    if ! command -v esptool.py >/dev/null 2>&1; then
        echo -e "${YELLOW}Installing esptool...${NC}"
        pip3 install esptool 2>/dev/null || apt-get install -y esptool 2>/dev/null || {
            echo -e "${RED}Cannot install esptool${NC}"; return 1; }
    fi
    
    echo -e "${BOLD}Flashing ${firmware} to Unit C6L...${NC}"
    echo "  Firmware: ${fw_path}"
    echo "  Port:     ${C6L_UART}"
    
    esptool.py --chip esp32c6 --port "${C6L_UART}" --baud 460800 \
        write_flash -z 0x0 "${fw_path}" || {
        echo -e "${RED}Flash failed${NC}"
        echo "  Hold BOOT + press RESET to enter download mode"
        return 1
    }
    
    echo -e "${GREEN}Firmware flashed${NC}"
    echo "  Reset: c6l-ctl reset"
    echo "  Console: c6l-ctl serial"
}

