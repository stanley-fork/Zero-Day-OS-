    echo -e "${CYAN}Grove chain: Cardputer Zero → M5MonsterC5 (IN) →${NC}"
    echo -e "${CYAN}  M5MonsterC5 has GPS Module v1.1 port + OUT port for C6L${NC}"
    echo -e "${CYAN}C6L unique value: Zigbee/Thread + BLE 5 (no other device covers this)${NC}"
    echo -e "${CYAN}WiFi 6 available as bonus; M5MonsterC5 is the primary WiFi attack radio${NC}"
    echo ""
    echo "  I2C Bus:        ${C6L_I2C_BUS}"
    echo "  I2C Address:   ${C6L_I2C_ADDR} (LCD)"
    echo "  UART Device:    ${C6L_UART}"
    echo "  UART Baud:      ${C6L_UART_BAUD}"
    echo "  Firmware Dir:   ${FIRMWARE_DIR}"
}

case "${1:-help}" in
    probe)          cmd_probe ;;
    flash)          cmd_flash "${2:-}" ;;
    wifi)
        case "${2:-}" in
            scan)      cmd_wifi_scan ;;
            deauth)    cmd_wifi_deauth "${3:-}" "${4:-}" ;;
            *)         echo "Usage: c6l-ctl wifi {scan|deauth <BSSID> <CH>}"; exit 1 ;;
        esac
        ;;
    zigbee)
        case "${2:-}" in
            scan)      cmd_zigbee_scan ;;
            sniffer)   cmd_zigbee_sniffer ;;
            attack)    cmd_zigbee_attack "${3:-}" ;;
            *)         echo "Usage: c6l-ctl zigbee {scan|sniffer|attack <panid>}"; exit 1 ;;
        esac
        ;;
    ble)
        case "${2:-}" in
            scan)      cmd_ble_scan ;;
            connect)   cmd_ble_connect "${3:-}" ;;
            pair)      cmd_ble_pair ;;
            *)         echo "Usage: c6l-ctl ble {scan|connect <MAC>|pair}"; exit 1 ;;
        esac
        ;;
    lcd)
        case "${2:-}" in
            text)      cmd_lcd_text "${@:3}" ;;
            status)    cmd_lcd_status ;;
            *)         echo "Usage: c6l-ctl lcd {text <msg>|status}"; exit 1 ;;
        esac
        ;;
    serial)         cmd_serial ;;
    reset)           cmd_reset ;;
    config)          cmd_config ;;
    help|-h|--help)
        echo "c6l-ctl — M5Stack Unit C6L (ESP32-C6) controller for ZERO-DAY OS"
        echo ""
        echo "Usage: c6l-ctl <command> [args]"
        echo ""
        echo "Unit C6L: ESP32-C6 with WiFi 6, Zigbee/Thread, BLE 5, 0.96\" LCD"
        echo "Connects via M5MonsterC5 Grove OUT (routed through middle manager)"
        echo ""
        echo "  Cardputer Zero ─→ MonsterC5 (ESP32C5) ─→ C6L (ESP32-C6)"
        echo "                       ├── GPS v1.1 (Grove IN)"
        echo "                       └── C6L (Grove OUT)"
        echo ""
        echo "Commands:"
        echo "  probe                      Probe for C6L via MonsterC5"
        echo "  flash <firmware>            Flash firmware to C6L (direct USB)"
        echo "  wifi scan                   WiFi 6 scan via C6L"
        echo "  wifi deauth <BSSID> <CH>    Deauth via C6L WiFi 6 radio"
        echo "  zigbee scan                 Scan Zigbee/Thread networks"
        echo "  zigbee sniffer              Capture Zigbee packets"
        echo "  zigbee attack <panid>       Join/attack Zigbee network"
        echo "  ble scan                    BLE 5 scan via C6L"
        echo "  ble connect <MAC>           Connect to BLE peripheral"
        echo "  ble pair                    Scan & pair C6L via direct BLE (no cables)"
        echo "  lcd text <msg>              Display text on C6L LCD"
        echo "  lcd status                  Show system status on C6L LCD"
        echo "  serial                      Open serial console (direct USB)"
        echo "  reset                       Reset C6L"
        echo "  config                      Show configuration and wiring"
        echo ""
        echo "Grove port modes (on M5MonsterC5 OUT):"
        echo "  I2C:  SW1=ON,  SW2=ON  (LCD control)"
        echo "  UART: SW1=OFF, SW2=OFF (serial communication)"
        echo ""
        echo "Communication:"
        echo "  Via MonsterC5:  monsterctl c6l_cmd <command>  (default, auto)"
        echo "  Direct USB-C:   C6L_MODE=direct C6L_UART=/dev/ttyUSBx"
        echo ""
        echo "Environment:"
        echo "  C6L_MODE=auto|direct   Communication mode (default: auto)"
        echo "  C6L_I2C_BUS=1          I2C bus for LCD"
        echo "  C6L_I2C_ADDR=0x3C       LCD I2C address"
        echo "  C6L_UART=/dev/ttyUSB0   Direct serial device"
        echo "  C6L_UART_BAUD=115200     Direct serial baud rate"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run: c6l-ctl help"
        exit 1
        ;;
esac