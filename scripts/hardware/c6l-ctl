        echo "Usage: c6l-ctl ble connect <MAC_ADDRESS>"
        return 1
    fi
    
    echo -e "${BOLD}Connecting to BLE device ${mac} via C6L...${NC}"
    
    c6l_send "BLE_CONNECT_${mac}" || return 1
    echo -e "${YELLOW}Connected. Use 'c6l-ctl serial' for interactive GATT operations${NC}"
}

cmd_ble_pair() {
    echo -e "${BOLD}${CYAN}Scanning for C6L BLE device...${NC}"
    echo ""
    
    # Scan for ESP32-C6 devices with BLE
    local devs=$(bluetoothctl --timeout 10 scan on 2>/dev/null | grep -i "ESP32\|C6L\|M5Stack" || true)
    
    if [ -z "$devs" ]; then
        echo -e "${YELLOW}No C6L found. Ensure C6L is powered on and BLE advertising.${NC}"
        echo -e "${CYAN}Tip: Power on C6L and run 'c6l-ctl ble pair' again${NC}"
        return 1
    fi
    
    echo -e "${GREEN}Found C6L devices:${NC}"
    echo "$devs"
    echo ""
    echo -ne "${CYAN}Enter MAC address to pair: ${NC}"
    read -r mac
    
    if [ -z "$mac" ]; then
        echo -e "${RED}No MAC address entered${NC}"
        return 1
    fi
    
    echo -e "${CYAN}Pairing with ${mac}...${NC}"
    bluetoothctl --timeout 10 <<< "pair ${mac}" 2>/dev/null
    
    # Save MAC for future BLE connections
    echo "$mac" > /opt/cardputer/config/c6l_ble_mac 2>/dev/null || true
    echo -e "${GREEN}C6L BLE MAC saved: ${mac}${NC}"
    echo -e "${CYAN}Use C6L_MODE=ble c6l-ctl <command> for direct BLE communication${NC}"
}

