#!/bin/bash
# /usr/local/bin/yt
# YouTube search and play on ZERO-DAY OS
# Uses yt-dlp for search/download and ffplay/mpv for playback
# Optimized for Cardputer Zero (320x170 LCD or HDMI output)

OUTDIR="/opt/cardputer/loot/yt"
MUSICDIR="/opt/cardputer/music"
mkdir -p "$OUTDIR"

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

usage() {
    echo -e "${CYAN}yt${NC} — YouTube Search & Play for ZERO-DAY OS"
    echo ""
    echo "Usage: yt <command> [args]"
    echo ""
    echo "Commands:"
    echo "  search <query>       Search YouTube and select a video"
    echo "  play <url|id>         Play a YouTube video directly"
    echo "  audio <url|id>        Play just the audio (music mode)"
    echo "  download <url|id>     Download video to SD card"
    echo "  download-audio <url>  Download audio only (MP3/OPUS)"
    echo "  queue <url|id>        Add to play queue"
    echo "  history               Show play history"
    echo "  trending              Show trending videos"
    echo ""
    echo "Playback:"
    echo "  - On LCD (default):  scaled to 320x170"
    echo "  - On HDMI:           use 'export ZERODAY_DISPLAY=hdmi'"
    echo "  - Audio only:        use 'audio' command (saves battery)"
    echo ""
    echo "Examples:"
    echo "  yt search 'wireless hacking tutorial'"
    echo "  yt play https://youtube.com/watch?v=dQw4w9WgXcQ"
    echo "  yt audio dQw4w9WgXcQ"
    echo "  yt download https://youtube.com/watch?v=dQw4w9WgXcQ"
}

check_deps() {
    for cmd in yt-dlp; do
        if ! command -v "$cmd" &>/dev/null; then
            echo -e "${RED}[!] $cmd not found. Install: pip3 install yt-dlp${NC}"
            exit 1
        fi
    done
    if ! command -v ffplay &>/dev/null && ! command -v mpv &>/dev/null; then
        echo -e "${RED}[!] No video player found. Install ffmpeg or mpv.${NC}"
        exit 1
    fi
}

get_player_cmd() {
    if [ "$ZERODAY_DISPLAY" = "hdmi" ]; then
        if command -v mpv &>/dev/null; then
            echo "mpv --fs --no-border --force-window=no"
        else
            echo "ffplay -fs -autoexit -loglevel quiet"
        fi
    else
        if command -v mpv &>/dev/null; then
            echo "mpv --no-video --force-window=no"
        else
            echo "ffplay -nodisp -autoexit -loglevel quiet"
        fi
    fi
}

get_video_player_cmd() {
    if [ "$ZERODAY_DISPLAY" = "hdmi" ]; then
        if command -v mpv &>/dev/null; then
            echo "mpv --fs --no-border"
        else
            echo "ffplay -fs -autoexit -loglevel quiet"
        fi
    else
        if command -v mpv &>/dev/null; then
            echo "mpv --vo=gpu --gpu-context=drm --force-window=no --geometry=320x170 --no-border"
        else
            echo "ffplay -nodisp -autoexit -loglevel quiet"
        fi
    fi
}

search_videos() {
    local query="$*"
    echo -e "${CYAN}[*] Searching: ${query}${NC}"
    echo ""

    results=$(yt-dlp --flat-playlist --print "%(id)s|%(title)s|%(duration)s" \
        "ytsearch10:${query}" 2>/dev/null)

    if [ -z "$results" ]; then
        echo -e "${RED}[!] No results found.${NC}"
        return 1
    fi

    i=1
    declare -a ids
    while IFS='|' read -r id title duration; do
        ids[$i]="$id"
        echo -e "${GREEN}[${i}]${NC} ${title} ${YELLOW}(${duration})${NC}"
        echo -e "    https://youtube.com/watch?v=${id}"
        ((i++))
    done <<< "$results"

    echo ""
    echo -e "${CYAN}Select [1-$((i-1))] or [q]uit: \c${NC}"
    read -r choice

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$i" ]; then
        local selected_id="${ids[$choice]}"
        echo -e "${GREEN}[*] Playing: ${selected_id}${NC}"
        play_video "https://youtube.com/watch?v=${selected_id}"
    fi
}

play_video() {
    local url="$1"
    local player
    player=$(get_video_player_cmd)

    echo -e "${CYAN}[*] Playing video...${NC}"
    echo -e "${CYAN}[*] Player: ${player}${NC}"

    # Use yt-dlp to get the stream URL and pipe to player
    if command -v mpv &>/dev/null; then
        mpv --ytdl-format="worst[height<=480]" "$url" 2>/dev/null
    else
        stream_url=$(yt-dlp -f "worst[height<=480]" --get-url "$url" 2>/dev/null)
        if [ -n "$stream_url" ]; then
            ffplay -autoexit -loglevel quiet -i "$stream_url"
        else
            # Fallback: download then play
            tmpfile="${OUTDIR}/_play_$(date +%s).mp4"
            yt-dlp -f "worst[height<=480]" -o "$tmpfile" "$url" 2>/dev/null
            if [ -f "$tmpfile" ]; then
                ffplay -autoexit -loglevel quiet "$tmpfile"
                rm -f "$tmpfile"
            fi
        fi
    fi
}

play_audio() {
    local url="$1"
    local player
    player=$(get_player_cmd)

    echo -e "${CYAN}[*] Playing audio only (saves battery)...${NC}"

    if command -v mpv &>/dev/null; then
        mpv --no-video --force-window=no "$url" 2>/dev/null
    else
        stream_url=$(yt-dlp -f "worstaudio" --get-url "$url" 2>/dev/null)
        if [ -n "$stream_url" ]; then
            ffplay -nodisp -autoexit -loglevel quiet -i "$stream_url"
        else
            tmpfile="${OUTDIR}/_play_$(date +%s).opus"
            yt-dlp -f "worstaudio" --extract-audio --audio-format opus -o "$tmpfile" "$url" 2>/dev/null
            if [ -f "$tmpfile" ]; then
                ffplay -nodisp -autoexit -loglevel quiet "$tmpfile"
                rm -f "$tmpfile"
            fi
        fi
    fi
}

download_video() {
    local url="$1"
    local format="${2:-worst[height<=480]}"

    echo -e "${CYAN}[*] Downloading video...${NC}"
    yt-dlp -f "$format" -o "${OUTDIR}/%(title)s_%(id)s.%(ext)s" "$url"
    echo -e "${GREEN}[*] Saved to ${OUTDIR}/${NC}"
}

download_audio() {
    local url="$1"

    echo -e "${CYAN}[*] Downloading audio...${NC}"
    yt-dlp -f "worstaudio" --extract-audio --audio-format opus \
        -o "${MUSICDIR}/%(title)s_%(id)s.%(ext)s" "$url"
    echo -e "${GREEN}[*] Saved to ${MUSICDIR}/${NC}"
}

queue_add() {
    local url="$1"
    local queue_file="/opt/cardputer/config/yt_queue.txt"
    mkdir -p /opt/cardputer/config
    echo "$url" >> "$queue_file"
    echo -e "${GREEN}[*] Added to queue: ${url}${NC}"
    echo -e "${CYAN}[*] Queue has $(wc -l < "$queue_file") items${NC}"
}

show_history() {
    local hist_file="/opt/cardputer/config/yt_history.txt"
    if [ -f "$hist_file" ]; then
        echo -e "${CYAN}[*] Play History:${NC}"
        tail -20 "$hist_file"
    else
        echo -e "${YELLOW}[!] No play history yet.${NC}"
    fi
}

show_trending() {
    echo -e "${CYAN}[*] Fetching trending videos...${NC}"
    echo ""

    results=$(yt-dlp --flat-playlist --print "%(id)s|%(title)s|%(duration)s" \
        "https://www.youtube.com/feed/trending" 2>/dev/null | head -20)

    if [ -z "$results" ]; then
        echo -e "${RED}[!] Could not fetch trending. Check network.${NC}"
        return 1
    fi

    i=1
    declare -a ids
    while IFS='|' read -r id title duration; do
        ids[$i]="$id"
        echo -e "${GREEN}[${i}]${NC} ${title} ${YELLOW}(${duration})${NC}"
        ((i++))
    done <<< "$results"

    echo ""
    echo -e "${CYAN}Select [1-$((i-1))] or [q]uit: \c${NC}"
    read -r choice

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -lt "$i" ]; then
        local selected_id="${ids[$choice]}"
        play_video "https://youtube.com/watch?v=${selected_id}"
    fi
}

# Main
check_deps

case "${1:-}" in
    search)
        shift
        if [ -z "$*" ]; then
            echo -e "${YELLOW}Usage: yt search <query>${NC}"
            exit 1
        fi
        search_videos "$@"
        ;;
    play)
        shift
        if [ -z "${1:-}" ]; then
            echo -e "${YELLOW}Usage: yt play <url|id>${NC}"
            exit 1
        fi
        url="$1"
        [[ "$url" != http* ]] && url="https://youtube.com/watch?v=${url}"
        play_video "$url"
        # Log to history
        mkdir -p /opt/cardputer/config
        echo "$(date +%Y-%m-%d_%H:%M:%S) $url" >> /opt/cardputer/config/yt_history.txt
        ;;
    audio)
        shift
        if [ -z "${1:-}" ]; then
            echo -e "${YELLOW}Usage: yt audio <url|id>${NC}"
            exit 1
        fi
        url="$1"
        [[ "$url" != http* ]] && url="https://youtube.com/watch?v=${url}"
        play_audio "$url"
        mkdir -p /opt/cardputer/config
        echo "$(date +%Y-%m-%d_%H:%M:%S) [audio] $url" >> /opt/cardputer/config/yt_history.txt
        ;;
    download)
        shift
        if [ -z "${1:-}" ]; then
            echo -e "${YELLOW}Usage: yt download <url|id>${NC}"
            exit 1
        fi
        url="$1"
        [[ "$url" != http* ]] && url="https://youtube.com/watch?v=${url}"
        download_video "$url" "${2:-worst[height<=480]}"
        ;;
    download-audio)
        shift
        if [ -z "${1:-}" ]; then
            echo -e "${YELLOW}Usage: yt download-audio <url|id>${NC}"
            exit 1
        fi
        url="$1"
        [[ "$url" != http* ]] && url="https://youtube.com/watch?v=${url}"
        download_audio "$url"
        ;;
    queue)
        shift
        url="$1"
        [[ "$url" != http* ]] && url="https://youtube.com/watch?v=${url}"
        queue_add "$url"
        ;;
    history)
        show_history
        ;;
    trending)
        show_trending
        ;;
    *)
        usage
        ;;
esac