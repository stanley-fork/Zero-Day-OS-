#!/bin/bash
set -euo pipefail
# /usr/local/bin/rfid2-ctl
# M5Stack RFID2 Unit (WS1850S) controller for ZERO-DAY OS
#
# The M5Stack RFID2 Unit uses the WS1850S chip (MFRC522-compatible)
# on I2C address 0x28 via GPIO hat Grove port. It reads/writes ISO/IEC 14443
# Type A/B tags including MIFARE Classic, MIFARE Ultralight, NTAG213/215/216.
#
# WS1850S is register-compatible with MFRC522 — same command set,
# same PICC commands, same anticollision protocol. The only difference
# is the I2C address (0x28 vs 0x00 for MFRC522 on SPI).
#
# Usage:
#   rfid2-ctl probe           Probe for WS1850S on I2C
#   rfid2-ctl read             Read RFID/NFC tag (UID, type, NDEF)
#   rfid2-ctl dump             Dump full tag contents to file
#   rfid2-ctl write <data>     Write NDEF text record to NTAG
#   rfid2-clone <uid>          Clone UID to blank tag (emulation)
#   rfid2-ctl wipe             Wipe tag data (reset to factory)
#   rfid2-ctl detect           Continuous tag detection (monitor mode)
#   rfid2-ctl uid              Read and display only the UID
#   rfid2-ctl info             Show tag type, size, ATQA, SAK
#   rfid2-ctl config           Show RFID2 configuration and wiring

RFID2_I2C_BUS="${RFID2_I2C_BUS:-1}"
RFID2_I2C_ADDR="${RFID2_I2C_ADDR:-0x28}"
RFID2_LOOT="/opt/cardputer/loot/rf"
MFRC522_VERSION_ID=0x91
WS1850S_VERSION_ID=0x91

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

check_i2c() {
    if ! [ -e "/dev/i2c-${RFID2_I2C_BUS}" ]; then
        echo -e "${YELLOW}Loading I2C modules...${NC}"
        modprobe i2c-bcm2835 2>/dev/null || true
        modprobe i2c-dev 2>/dev/null || true
        sleep 1
    fi
    if ! [ -e "/dev/i2c-${RFID2_I2C_BUS}" ]; then
        echo -e "${RED}I2C bus ${RFID2_I2C_BUS} not available${NC}"
        echo "  Enable I2C: sudo raspi-config → Interface Options → I2C"
        return 1
    fi
}

check_deps() {
    if python3 -c "import mfrc522" 2>/dev/null; then
        return 0
    fi
    if python3 -c "from RPi import GPIO" 2>/dev/null; then
        return 0
    fi
    echo -e "${YELLOW}Installing MFRC522 Python library...${NC}"
    pip3 install mfrc522 RPi.GPIO 2>/dev/null || {
        echo -e "${YELLOW}pip install failed, trying apt...${NC}"
        apt-get install -y python3-rpi.gpio 2>/dev/null || true
        pip3 install mfrc522 2>/dev/null || {
            echo -e "${RED}Cannot install mfrc522 library${NC}"
            echo "  Manual: pip3 install mfrc522 RPi.GPIO"
            return 1
        }
    }
}

scan_i2c() {
    echo -e "${BOLD}Scanning I2C bus ${RFID2_I2C_BUS} for RFID modules...${NC}"
    local found=""
    found=$(i2cdetect -y "${RFID2_I2C_BUS}" 2>/dev/null | grep -i "28\|24\|08" || true)
    
    if echo "$found" | grep -q "28"; then
        echo -e "${GREEN}WS1850S/RFID2 detected at 0x28${NC}"
        return 0
    elif echo "$found" | grep -q "24"; then
        echo -e "${GREEN}PN532 detected at 0x24${NC}"
        echo "  Note: PN532 uses different commands — use nfc-read instead"
        return 0
    elif echo "$found" | grep -q "08"; then
        echo -e "${GREEN}MFRC522-compatible device at 0x08${NC}"
        return 0
    fi
    
    echo -e "${YELLOW}No RFID module detected on I2C bus ${RFID2_I2C_BUS}${NC}"
    echo ""
    echo "  Check:"
    echo "    1. M5Stack RFID2 Unit is connected to GPIO hat Grove port"
    echo "    2. I2C is enabled (raspi-config → Interface Options → I2C)"
    echo ""
    echo "  ${CYAN}Wiring — NFC/CC1101 GPIO hat extra Grove port:${NC}"
    echo "    M5Stack RFID2 Unit    GPIO Hat Grove Port"
    echo "    ──────────────────    ────────────────────"
    echo "    GND (Black)        →   GND"
    echo "    5V (Red)           →   VCC"
    echo "    SDA (Yellow)       →   SDA — I2C data"
    echo "    SCL (White)        →   SCL — I2C clock"
    echo ""
    echo "    Alternative I2C addresses:"
    echo "      0x28 — WS1850S (M5Stack RFID2 Unit, default)"
    echo "      0x24 — PN532 (some I2C variants)"
    echo "      0x08 — RC522 (some I2C modules)"
    return 1
}

cmd_probe() {
    check_i2c || return 1
    
    echo -e "${BOLD}M5Stack RFID2 Unit (WS1850S) Probe${NC}"
    echo "  I2C Bus:     ${RFID2_I2C_BUS}"
    echo "  I2C Address: ${RFID2_I2C_ADDR}"
    echo ""
    
    scan_i2c
    local scan_result=$?
    
    if [ $scan_result -eq 0 ]; then
        echo ""
        echo -e "${CYAN}Module Details:${NC}"
        echo "  Chip:        WS1850S (MFRC522-compatible)"
        echo "  Frequency:   13.56 MHz"
        echo "  Standard:    ISO/IEC 14443 Type A/B"
        echo "  Range:        < 20mm"
        echo "  Supported:   MIFARE Classic 1K/4K, MIFARE Ultralight,"
        echo "               NTAG213/215/216, MIFARE DESFire"
        echo ""
        echo -e "${GREEN}Ready to read/write tags${NC}"
        echo "  Use: rfid2-ctl read     — read a tag"
        echo "  Use: rfid2-ctl detect   — continuous detection"
    fi
    return $scan_result
}

cmd_read() {
    check_i2c || return 1
    check_deps || return 1
    
    local timestamp=$(date +%Y%m%d_%H%M%S)
    mkdir -p "${RFID2_LOOT}"
    local output="${RFID2_LOOT}/rfid2_read_${timestamp}.json"
    
    echo -e "${BOLD}Reading RFID/NFC tag...${NC}"
    echo "  Hold a tag near the RFID2 Unit"
    echo ""
    
    python3 << PYEOF
import sys
import json
import time

try:
    import mfrc522
    from mfrc522 import MFRC522
except ImportError:
    # Try SPI-based import for I2C variant
    print("[!] mfrc522 library not found")
    print("[!] Install: pip3 install mfrc522")
    sys.exit(1)

# WS1850S on I2C — use I2C mode
# The mfrc522 library uses SPI by default; for I2C we need smbus
try:
    import smbus
    bus = smbus.SMBus(${RFID2_I2C_BUS})
except Exception as e:
    print(f"[!] Cannot open I2C bus ${RFID2_I2C_BUS}: {e}")
    sys.exit(1)

WS1850S_ADDR = ${RFID2_I2C_ADDR}

# WS1850S/MFRC522 register map (I2C addresses differ from SPI)
# In I2C mode, register addressing uses the upper 6 bits as register
# and the MSB of the data byte as the register address continuation

def read_reg(reg):
    """Read a register from WS1850S via I2C"""
    try:
        val = bus.read_byte_data(WS1852S_ADDR if False else WS1850S_ADDR, reg)
        return val
    except:
        return 0

def write_reg(reg, val):
    """Write a register to WS1850S via I2C"""
    try:
        bus.write_byte_data(WS1850S_ADDR, reg, val)
    except Exception as e:
        print(f"[!] I2C write error: {e}")

# Check version register
version = read_reg(0x37)  # VersionReg
if version == 0x91 or version == 0x92:
    print(f"[+] WS1850S/MFRC522 detected (version: 0x{version:02X})")
elif version == 0x00:
    print("[!] No response from WS1850S — check wiring")
    sys.exit(1)
else:
    print(f"[?] Unknown chip version: 0x{version:02X}")
    print("[!] Proceeding anyway...")

# Try using mfrc522 library with SPI (may need adaptation for I2C)
# For now, use direct I2C anticollision
def picc_request():
    """Send REQA/WUPA command and check for tag"""
    write_reg(0x01, 0x0F)  # TxModeReg: reset
    write_reg(0x09, 0x4D)  # FIFOLevelReg: flush
    write_reg(0x01, 0x00)  # Clear all bits
    write_reg(0x0A, 0x07)  # CollReg: all RX bits after collision
    write_reg(0x09, 0x26)  # FIFOLevelReg: REQA command
    # CommandReg: Transceive
    write_reg(0x01, 0x0C)  # BitFramingReg: 7 bits for REQA
    write_reg(0x04, 0x07)  # CommandReg: Start transmission
    time.sleep(0.01)
    # Read result
    status = read_reg(0x07)  # Status1Reg
    irq = read_reg(0x04)     # CommIrqReg
    return irq & 0x20 != 0  # RxIRq flag

def picc_anticoll():
    """Perform anticollision and get UID"""
    write_reg(0x09, 0x4D)  # Flush FIFO
    # Anticollision command
    write_reg(0x0A, 0x00)  # CollReg: values after collision
    write_reg(0x09, 0x93)  # Anticoll command byte 1
    write_reg(0x04, 0x07)  # CommandReg: Transceive
    time.sleep(0.01)
    
    # Read UID from FIFO
    fifo_level = read_reg(0x0A) & 0x7F
    if fifo_level >= 5:
        uid = []
        for i in range(5):
            val = read_reg(0x09)  # FIFODataReg
            uid.append(val)
        return uid[:4], uid[4]  # uid, checksum
    return None, None

# Try to detect tag
print("[*] Scanning for tags...")
tag_found = False
for attempt in range(10):
    if picc_request():
        uid, checksum = picc_anticoll()
        if uid is not None:
            uid_str = ':'.join(f'{b:02X}' for b in uid)
            print(f"[+] Tag detected!")
            print(f"    UID:    {uid_str}")
            
            # Determine tag type from SAK
            # This is approximate — full ATQA/SAK detection requires SELECT
            print(f"    Type:   ISO 14443-A")
            print(f"    Size:   Likely MIFARE or NTAG")
            
            tag_data = {
                "uid": uid_str,
                "type": "ISO 14443-A",
                "chip": "WS1850S",
                "bus": ${RFID2_I2C_BUS},
                "address": "${RFID2_I2C_ADDR}",
                "timestamp": "${timestamp}"
            }
            
            with open("${output}", "w") as f:
                json.dump(tag_data, f, indent=2)
            print(f"[+] Data saved: ${output}")
            print(f"[*] Clone with: rfid2-ctl clone {uid_str}")
            print(f"[*] Dump with: rfid2-ctl dump")
            tag_found = True
            break
    time.sleep(0.5)

if not tag_found:
    print("[!] No tag detected. Try holding a tag closer to the module.")
    sys.exit(1)
PYEOF
}

cmd_detect() {
    check_i2c || return 1
    
    echo -e "${BOLD}Continuous RFID/NFC detection (Ctrl+C to stop)...${NC}"
    echo ""
    
    python3 << PYEOF
import time
import smbus

try:
    bus = smbus.SMBus(${RFID2_I2C_BUS})
except Exception as e:
    print(f"[!] Cannot open I2C bus: {e}")
    exit(1)

WS1850S_ADDR = ${RFID2_I2C_ADDR}

def read_reg(reg):
    try:
        return bus.read_byte_data(WS1850S_ADDR, reg)
    except:
        return 0

def write_reg(reg, val):
    try:
        bus.write_byte_data(WS1850S_ADDR, reg, val)
    except:
        pass

print("[*] Scanning continuously... (Ctrl+C to stop)")
last_uid = ""

try:
    while True:
        # Reset and transmit REQA
        write_reg(0x01, 0x0F)
        time.sleep(0.001)
        write_reg(0x01, 0x00)
        write_reg(0x09, 0x26)  # REQA
        write_reg(0x01, 0x0C)  # 7-bit TX
        write_reg(0x04, 0x07)  # Transceive
        time.sleep(0.01)
        
        # Check if tag responded
        irq = read_reg(0x04)
        if irq & 0x20:
            # Tag present — try anticollision
            write_reg(0x09, 0x4D)  # Flush
            write_reg(0x09, 0x93)  # Anticoll CL1
            write_reg(0x04, 0x07)
            time.sleep(0.01)
            
            n = read_reg(0x0A) & 0x7F
            if n >= 5:
                uid = []
                for _ in range(5):
                    uid.append(read_reg(0x09))
                uid_str = ':'.join(f'{b:02X}' for b in uid[:4])
                if uid_str != last_uid:
                    print(f"[+] {time.strftime('%H:%M:%S')} Tag: {uid_str}")
                    last_uid = uid_str
        else:
            if last_uid:
                print(f"[-] {time.strftime('%H:%M:%S')} Tag removed")
                last_uid = ""
        
        time.sleep(0.2)

except KeyboardInterrupt:
    print("\\n[*] Detection stopped")
PYEOF
}

cmd_uid() {
    check_i2c || return 1
    
    python3 << PYEOF
import smbus, time

bus = smbus.SMBus(${RFID2_I2C_BUS})
ADDR = ${RFID2_I2C_ADDR}

def r(reg):
    try: return bus.read_byte_data(ADDR, reg)
    except: return 0
def w(reg, val):
    try: bus.write_byte_data(ADDR, reg, val)
    except: pass

# Request
w(0x01, 0x0F); time.sleep(0.001); w(0x01, 0x00)
w(0x09, 0x26); w(0x01, 0x0C); w(0x04, 0x07); time.sleep(0.01)

irq = r(0x04)
if irq & 0x20:
    w(0x09, 0x4D); w(0x09, 0x93); w(0x04, 0x07); time.sleep(0.01)
    n = r(0x0A) & 0x7F
    if n >= 5:
        uid = [r(0x09) for _ in range(5)]
        uid_str = ':'.join(f'{b:02X}' for b in uid[:4])
        print(uid_str)
    else:
        print("READ_ERROR")
else:
    print("NO_TAG")
PYEOF
}

cmd_dump() {
    local output="${RFID2_LOOT}/rfid2_dump_$(date +%Y%m%d_%H%M%S).mfd"
    echo -e "${BOLD}Dumping tag data (requires mfoc)...${NC}"
    mkdir -p "${RFID2_LOOT}"
    
    # mfoc requires the PN532/ACR122U interface; for WS1850S on I2C
    # we fall back to raw dump via Python
    if command -v mfoc >/dev/null 2>&1; then
        mfoc -O "${output}" 2>/dev/null && {
            echo -e "${GREEN}MIFARE dump saved: ${output}${NC}"
            return 0
        }
    fi
    
    echo -e "${YELLOW}mfoc not available, trying raw I2C dump...${NC}"
    echo "  Hold a MIFARE Classic tag near the module"
    
    python3 << PYEOF
import smbus, time, json

bus = smbus.SMBus(${RFID2_I2C_BUS})
ADDR = ${RFID2_I2C_ADDR}

def r(reg):
    try: return bus.read_byte_data(ADDR, reg)
    except: return 0
def w(reg, val):
    try: bus.write_byte_data(ADDR, reg, val)
    except: pass

# Simple tag detection and UID read
w(0x01, 0x0F); time.sleep(0.001); w(0x01, 0x00)
w(0x09, 0x26); w(0x01, 0x0C); w(0x04, 0x07); time.sleep(0.01)

irq = r(0x04)
if irq & 0x20:
    w(0x09, 0x4D); w(0x09, 0x93); w(0x04, 0x07); time.sleep(0.01)
    n = r(0x0A) & 0x7F
    if n >= 5:
        uid = [r(0x09) for _ in range(5)]
        uid_str = ':'.join(f'{b:02X}' for b in uid[:4])
        print(f"[+] UID: {uid_str}")
        print("[!] Full sector dump requires mfoc or proxmark3")
        print("[!] Install: apt install mfoc proxmark3")
    else:
        print("[!] Could not read tag UID")
else:
    print("[!] No tag detected")
PYEOF
}

cmd_write() {
    local data="${1:-Hello}"
    echo -e "${BOLD}Writing NDEF text to NTAG...${NC}"
    echo "  Data: ${data}"
    echo "  Hold an NTAG213/215/216 tag near the module"
    echo ""
    echo -e "${YELLOW}Note: NDEF writing requires more complete MFRC522${NC}"
    echo -e "${YELLOW}driver support. For now, use nfc-clone for UID cloning${NC}"
    echo -e "${YELLOW}or a Proxmark3 for full tag writing.${NC}"
}

cmd_wipe() {
    echo -e "${BOLD}Wiping tag...${NC}"
    echo -e "${YELLOW}Tag wipe requires sector-level write capability.${NC}"
    echo "  Use a Proxmark3 (pm3) for full tag wipe:"
    echo "    pm3 --> hf mf wipe"
    echo ""
    echo "  Or zero-fill a MIFARE Classic dump:"
    echo "    nfc-clone --wipe"
}

cmd_config() {
    echo -e "${BOLD}M5Stack RFID2 Unit (WS1850S) Configuration${NC}"
    echo ""
    echo "  Chip:            WS1850S (MFRC522-compatible)"
    echo "  Frequency:       13.56 MHz"
    echo "  I2C Bus:         ${RFID2_I2C_BUS}"
    echo "  I2C Address:     ${RFID2_I2C_ADDR}"
    echo "  Standard:        ISO/IEC 14443 Type A/B"
    echo "  Read distance:    < 20mm"
    echo "  Grove port:       GPIO hat extra port (I2C mode)"
    echo ""
    echo "  ${CYAN}Wiring — NFC/CC1101 GPIO hat extra Grove port:${NC}"
    echo "    M5Stack RFID2 Unit    GPIO Hat Grove Port"
    echo "    ──────────────────    ────────────────────"
    echo "    GND (Black)        →   GND"
    echo "    5V (Red)           →   VCC"
    echo "    SDA (Yellow)       →   SDA — I2C data"
    echo "    SCL (White)        →   SCL — I2C clock"
    echo ""
    echo "  ${CYAN}Supported tag types:${NC}"
    echo "    MIFARE Classic 1K/4K    MIFARE Ultralight"
    echo "    NTAG213/215/216         MIFARE DESFire"
    echo "    ISO 14443-A             ISO 14443-B"
    echo ""
    echo "  ${CYAN}Comparison with PN532:${NC}"
    echo "    PN532:         I2C 0x24, SPI, UART, supports FeliCa"
    echo "    WS1850S:       I2C 0x28, MFRC522-compatible, MIFARE only"
    echo "    MFRC522:       SPI only (0x00), same register map as WS1850S"
    echo ""
    echo "  ${CYAN}Grove port sharing:${NC}"
    echo "    RFID2 (I2C), SH1107 OLED (I2C), PN532 (I2C) share the port"
    echo "    GPS (UART), Meshtastic (UART) use UART mode on the same port"
    echo "    Only one I2C device or one UART device at a time"
    echo ""
    echo "  Environment variables:"
    echo "    RFID2_I2C_BUS=${RFID2_I2C_BUS}   (I2C bus number)"
    echo "    RFID2_I2C_ADDR=${RFID2_I2C_ADDR}  (I2C address, hex)"
}

case "${1:-help}" in
    probe)      cmd_probe ;;
    read)       cmd_read ;;
    dump)       cmd_dump ;;
    write)      cmd_write "${2:-Hello}" ;;
    clone)      echo "Use: nfc-clone <UID>" ;;
    wipe)       cmd_wipe ;;
    detect)     cmd_detect ;;
    uid)        cmd_uid ;;
    info)       cmd_probe ;;
    config)     cmd_config ;;
    help|-h|--help)
        echo "rfid2-ctl — M5Stack RFID2 Unit (WS1850S) controller for ZERO-DAY OS"
        echo ""
        echo "Usage: rfid2-ctl <command> [args]"
        echo ""
        echo "Commands:"
        echo "  probe           Probe for WS1850S on I2C"
        echo "  read            Read RFID/NFC tag (UID, type, NDEF)"
        echo "  dump            Dump full tag contents"
        echo "  write <text>    Write NDEF text record to NTAG"
        echo "  clone <uid>     Clone UID (use nfc-clone)"
        echo "  wipe            Wipe tag data"
        echo "  detect          Continuous tag detection (monitor)"
        echo "  uid             Read and display UID only"
        echo "  config          Show RFID2 configuration and wiring"
        echo ""
        echo "Chip:     WS1850S (MFRC522-compatible)"
        echo "Address:  I2C 0x28"
        echo "Tags:     MIFARE Classic, Ultralight, NTAG213/215/216"
        echo ""
        echo "Environment:"
        echo "  RFID2_I2C_BUS=1     I2C bus number"
        echo "  RFID2_I2C_ADDR=0x28  I2C address (hex)"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run: rfid2-ctl help"
        exit 1
        ;;
esac