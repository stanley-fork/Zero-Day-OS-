#!/bin/bash
# /usr/local/bin/retro-play
# Retro game emulator launcher for ZERO-DAY OS
# Supports NES, SNES, Game Boy, GBC, GBA, Sega Master System, Sega Genesis
# Uses retroarch with lightweight cores optimized for ARM64/512MB RAM

RETRO_DIR="/opt/cardputer/retro"
ROM_DIR="/opt/cardputer/retro/roms"
SAVE_DIR="/opt/cardputer/retro/saves"
CFG_DIR="/opt/cardputer/config/retroarch"

RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
MAGENTA='\033[0;35m'
NC='\033[0m'

SYSTEMS=(
    "nes:NES:Famicom:Nintendo Entertainment System"
    "snes:SNES:Super Nintendo:Super Famicom"
    "gb:Game Boy:GB:Nintendo Game Boy"
    "gbc:Game Boy Color:GBC:Nintendo Game Boy Color"
    "gba:Game Boy Advance:GBA:Nintendo Game Boy Advance"
    "sms:Master System:SMS:Sega Master System"
    "genesis:Genesis:Mega Drive:Sega Genesis"
    "atari2600:Atari 2600:A2600:Atari 2600"
    "pcengine:PC Engine:TG16:PC Engine / TurboGrafx-16"
    "lynx:Atari Lynx:Lynx:Atari Lynx"
)

CORE_MAP=(
    "nes:nes:fceumm:FCEUmm"
    "snes:snes:snes9x:Snes9x"
    "gb:gb:gambatte:Gambatte"
    "gbc:gbc:gambatte:Gambatte"
    "gba:gba:mgba:mGBA"
    "sms:sms:gens:Gens"
    "genesis:genesis:genesis_plus_gx:Genesis Plus GX"
    "atari2600:a2600:stella2014:Stella"
    "pcengine:pcengine:mednafen_pce:Mednafen PCE"
    "lynx:lynx:mednafen_lynx:Mednafen Lynx"
)

ROM_EXTS=(
    "nes:.nes .fds .unf"
    "snes:.smc .sfc .swc .fig"
    "gb:.gb .dmg"
    "gbc:.gbc"
    "gba:.gba"
    "sms:.sms"
    "genesis:.gen .md .smd .bin"
    "atari2600:.a26 .bin"
    "pcengine:.pce .tg16 .cue"
    "lynx:.lnx"
)

setup_retroarch() {
    mkdir -p "$CFG_DIR" "$ROM_DIR" "$SAVE_DIR"

    for sys in nes snes gb gbc gba sms genesis atari2600 pcengine lynx; do
        mkdir -p "${ROM_DIR}/${sys}"
    done

    if [ ! -f "${CFG_DIR}/retroarch.cfg" ]; then
        cat > "${CFG_DIR}/retroarch.cfg" << 'EOF'
# ZERO-DAY OS RetroArch Configuration
# Optimized for Cardputer Zero (320x170, ARM64, 512MB RAM)

# Video
video_driver = "gl"
video_fullscreen = true
video_scale = 1.0
video_threaded = true
video_vsync = true
video_hard_sync = false
video_refresh_rate = 60.0
video_gpu_screenshot = false

# On LCD: scale to 320x170
# video_scale_integer = false
# video_force_aspect = true
# video_aspect_ratio = 1.88 (320/170)

# Audio
audio_driver = "alsa"
audio_enable = true
audio_out_rate = 44100
audio_latency = 64
audio_sync = true

# Input
input_driver = "udev"
input_autodetect_enable = true
input_menu_toggle = "f1"
input_hold_fast_forward = "l2"
input_load_state = "f4"
input_save_state = "f2"
input_state_slot_increase = "f6"
input_state_slot_decrease = "f5"
input_quit = "escape"

# Performance
savestate_auto_save = false
savestate_auto_load = false
slowmotion_ratio = 3.0
fastforward_ratio = 4.0

# UI
menu_driver = "rgui"
menu_show_start_screen = false
ui_companion_start = false
pause_nonactive = false

# Save files
savefile_directory = "/opt/cardputer/retro/saves"
savestate_directory = "/opt/cardputer/retro/saves"
system_directory = "/opt/cardputer/retro/system"

# Logging
log_verbosity = 1
EOF
        echo -e "${GREEN}[*] RetroArch config created: ${CFG_DIR}/retroarch.cfg${NC}"
    fi
}

find_core() {
    local system="$1"
    for entry in "${CORE_MAP[@]}"; do
        IFS=':' read -r sys core_dir core_name core_desc <<< "$entry"
        if [ "$sys" = "$system" ]; then
            # Try multiple core paths
            for core_path in \
                "/usr/lib/arm-linux-gnueabihf/libretro/${core_name}_libretro.so" \
                "/usr/lib/aarch64-linux-gnu/libretro/${core_name}_libretro.so" \
                "/usr/local/lib/libretro/${core_name}_libretro.so" \
                "/opt/cardputer/retro/cores/${core_name}_libretro.so"; do
                if [ -f "$core_path" ]; then
                    echo "$core_path"
                    return 0
                fi
            done
        fi
    done
    return 1
}

get_rom_exts() {
    local system="$1"
    for entry in "${ROM_EXTS[@]}"; do
        IFS=':' read -r sys exts <<< "$entry"
        if [ "$sys" = "$system" ]; then
            echo "$exts"
            return
        fi
    done
    echo ".rom"
}

list_roms() {
    local system="$1"
    local rom_path="${ROM_DIR}/${system}"
    echo -e "${CYAN}[*] ROMs in ${rom_path}:${NC}"
    if [ -d "$rom_path" ]; then
        local count=$(find "$rom_path" -maxdepth 1 -type f 2>/dev/null | wc -l)
        if [ "$count" -eq 0 ]; then
            echo -e "${YELLOW}    No ROMs found. Add ROMs to:${NC}"
            echo -e "${YELLOW}    ${rom_path}/${NC}"
        else
            find "$rom_path" -maxdepth 1 -type f -printf "    %f\n" | sort
        fi
    else
        echo -e "${YELLOW}    Directory not created yet.${NC}"
    fi
}

launch_game() {
    local system="$1"
    local rom="$2"

    # Check for retroarch
    if ! command -v retroarch &>/dev/null; then
        echo -e "${RED}[!] RetroArch not found. Install: apt install retroarch${NC}"
        echo -e "${YELLOW}[i] Or install cores individually:${NC}"
        echo "    apt install libretro-fceumm     # NES"
        echo "    apt install libretro-snes9x     # SNES"
        echo "    apt install libretro-gambatte   # GB/GBC"
        echo "    apt install libretro-mgba        # GBA"
        echo "    apt install libretro-genesisplusgx # Genesis/SMS"
        return 1
    fi

    local core_path
    core_path=$(find_core "$system")
    if [ -z "$core_path" ]; then
        echo -e "${RED}[!] Core for ${system} not found.${NC}"
        echo -e "${YELLOW}[i] Install the core package for ${system}${NC}"
        return 1
    fi

    # Find ROM
    local rom_file="$rom"
    if [ ! -f "$rom_file" ]; then
        # Search in system ROM directory
        rom_file="${ROM_DIR}/${system}/${rom}"
    fi
    if [ ! -f "$rom_file" ]; then
        echo -e "${RED}[!] ROM not found: ${rom}${NC}"
        echo -e "${YELLOW}[i] Place ROMs in: ${ROM_DIR}/${system}/${NC}"
        list_roms "$system"
        return 1
    fi

    echo -e "${CYAN}╔══════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     R E T R O   G A M I N G     ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════╝${NC}"
    echo ""
    echo -e "${GREEN}[*] System: ${system}${NC}"
    echo -e "${GREEN}[*] Core:   ${core_path}${NC}"
    echo -e "${GREEN}[*] ROM:    ${rom_file}${NC}"
    echo ""
    echo -e "${YELLOW}[i] Controls:${NC}"
    echo "    Arrows         = D-Pad"
    echo "    Z/J            = Button A"
    echo "    X/K            = Button B"
    echo "    Space/Enter    = Start"
    echo "    Tab            = Select"
    echo "    F1             = RetroArch Menu"
    echo ""

    setup_retroarch >/dev/null 2>&1

    local res_args=""
    if [ "$ZERODAY_DISPLAY" != "hdmi" ]; then
        res_args="--set-shader \"\" --fullscreen"
    fi

    retroarch -L "$core_path" "$rom_file" \
        --config "${CFG_DIR}/retroarch.cfg" \
        $res_args 2>/dev/null
}

interactive_select() {
    echo -e "${CYAN}╔══════════════════════════════════╗${NC}"
    echo -e "${CYAN}║   R E T R O   G A M I N G       ║${NC}"
    echo -e "${MAGENTA}║   Cardputer Zero Edition          ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════╝${NC}"
    echo ""

    # List systems
    echo -e "${GREEN}Select system:${NC}"
    local i=1
    declare -a sys_keys
    for entry in "${SYSTEMS[@]}"; do
        IFS=':' read -r key short_name long_name desc <<< "$entry"
        sys_keys[$i]="$key"
        local rom_count=0
        if [ -d "${ROM_DIR}/${key}" ]; then
            rom_count=$(find "${ROM_DIR}/${key}" -maxdepth 1 -type f 2>/dev/null | wc -l)
        fi
        echo -e "  ${GREEN}[${i}]${NC} ${short_name} (${desc}) ${YELLOW}[${rom_count} ROMs]${NC}"
        ((i++))
    done
    echo -e "  ${GREEN}[q]${NC} Quit"
    echo ""
    echo -e "${CYAN}Choice: \c${NC}"
    read -r choice

    if [[ "$choice" == "q" ]] || [[ "$choice" == "Q" ]]; then
        return
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -ge "$i" ]; then
        echo -e "${RED}[!] Invalid choice${NC}"
        return 1
    fi

    local system="${sys_keys[$choice]}"

    # List ROMs for selected system
    local rom_path="${ROM_DIR}/${system}"
    local roms=()
    if [ -d "$rom_path" ]; then
        local exts
        exts=$(get_rom_exts "$system")
        while IFS= read -r -d '' f; do
            roms+=("$f")
        done < <(find "$rom_path" -maxdepth 1 -type f \( ${exts// / -o -name } \) -print0 2>/dev/null | sort -z)
    fi

    if [ ${#roms[@]} -eq 0 ]; then
        echo -e "${YELLOW}[!] No ROMs found for this system.${NC}"
        echo -e "${YELLOW}[i] Add ROMs to: ${rom_path}/${NC}"
        echo ""
        echo -e "${CYAN}Enter ROM path manually (or press Enter to quit): \c${NC}"
        read -r manual_rom
        if [ -n "$manual_rom" ] && [ -f "$manual_rom" ]; then
            launch_game "$system" "$manual_rom"
        fi
        return
    fi

    echo ""
    echo -e "${GREEN}Select game:${NC}"
    local j=1
    for rom in "${roms[@]}"; do
        echo -e "  ${GREEN}[${j}]${NC} $(basename "$rom")"
        ((j++))
    done
    echo -e "  ${GREEN}[q]${NC} Back"
    echo ""
    echo -e "${CYAN}Choice: \c${NC}"
    read -r game_choice

    if [[ "$game_choice" == "q" ]] || [[ "$game_choice" == "Q" ]]; then
        return
    fi

    if ! [[ "$game_choice" =~ ^[0-9]+$ ]] || [ "$game_choice" -lt 1 ] || [ "$game_choice" -gt "${#roms[@]}" ]; then
        echo -e "${RED}[!] Invalid choice${NC}"
        return 1
    fi

    launch_game "$system" "${roms[$((game_choice-1))]}"
}

# Main
mkdir -p "$ROM_DIR" "$SAVE_DIR"

case "${1:-}" in
    nes|snes|gb|gbc|gba|sms|genesis|atari2600|pcengine|lynx)
        system="$1"
        shift
        if [ -n "${1:-}" ]; then
            launch_game "$system" "$1"
        else
            list_roms "$system"
            echo ""
            echo -e "${CYAN}Usage: retro-play ${system} <rom_file>${NC}"
        fi
        ;;
    scan)
        echo -e "${CYAN}[*] Scanning ROM directories...${NC}"
        for entry in "${SYSTEMS[@]}"; do
            IFS=':' read -r key short_name long_name desc <<< "$entry"
            local count=0
            if [ -d "${ROM_DIR}/${key}" ]; then
                count=$(find "${ROM_DIR}/${key}" -maxdepth 1 -type f 2>/dev/null | wc -l)
            fi
            echo -e "  ${GREEN}${short_name}${NC}: ${count} ROMs"
        done
        ;;
    setup)
        setup_retroarch
        echo -e "${GREEN}[*] RetroArch configured for ZERO-DAY OS${NC}"
        echo -e "${YELLOW}[i] Place ROMs in: ${ROM_DIR}/<system>/${NC}"
        ;;
    list)
        system="${2:-}"
        if [ -n "$system" ]; then
            list_roms "$system"
        else
            for entry in "${SYSTEMS[@]}"; do
                IFS=':' read -r key short_name long_name desc <<< "$entry"
                list_roms "$key"
            done
        fi
        ;;
    cores)
        echo -e "${CYAN}[*] Checking installed cores...${NC}"
        for entry in "${CORE_MAP[@]}"; do
            IFS=':' read -r sys core_dir core_name core_desc <<< "$entry"
            core_path=$(find_core "$sys")
            if [ -n "$core_path" ]; then
                echo -e "  ${GREEN}[OK]${NC} ${core_desc} (${core_name})"
            else
                echo -e "  ${RED}[--]${NC} ${core_desc} (${core_name}) — not installed"
            fi
        done
        ;;
    help|--help|-h|"")
        echo -e "${CYAN}retro-play${NC} — Retro Game Emulator for ZERO-DAY OS"
        echo ""
        echo "Usage: retro-play <system> <rom>"
        echo "       retro-play (interactive menu)"
        echo ""
        echo "Systems:  nes snes gb gbc gba sms genesis"
        echo "          atari2600 pcengine lynx"
        echo ""
        echo "Commands:"
        echo "  play <system> <rom>  Launch a ROM file"
        echo "  list [system]        List available ROMs"
        echo "  cores                Check installed emulator cores"
        echo "  scan                 Scan ROM directories"
        echo "  setup                Configure RetroArch"
        echo ""
        echo "ROM directories:"
        for entry in "${SYSTEMS[@]}"; do
            IFS=':' read -r key short_name long_name desc <<< "$entry"
            echo "  ${ROM_DIR}/${key}/  (${desc})"
        done
        echo ""
        echo "Set ZERODAY_DISPLAY=hdmi for HDMI fullscreen output."
        ;;
    *)
        # Try to auto-detect: if arg is a ROM file, play it
        if [ -f "${1:-}" ]; then
            ext="${1##*.}"
            case "$ext" in
                nes|fds|unf) system="nes" ;;
                smc|sfc|swc|fig) system="snes" ;;
                gb|dmg) system="gb" ;;
                gbc) system="gbc" ;;
                gba) system="gba" ;;
                sms) system="sms" ;;
                gen|md|smd) system="genesis" ;;
                a26) system="atari2600" ;;
                pce|tg16) system="pcengine" ;;
                lnx) system="lynx" ;;
                *) system="nes" ;;
            esac
            launch_game "$system" "$1"
        else
            interactive_select
        fi
        ;;
esac